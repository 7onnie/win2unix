<?xml version="1.0" encoding="UTF-16"?>
<!--
  Geplante Aufgabe "win2unix-rsyncd" (Issue #13). START-RSYNC-SERVER.cmd setzt
  @WORKDIR@ (XML-escaped) ein, speichert als UTF-16 und registriert per
  "schtasks /Create /XML". Schema 1.2 = Windows 7 / Server 2008 R2.

  Warum jede Einstellung da steht:
  - SYSTEM (S-1-5-18, sprachunabhaengig): laeuft ohne Anmeldung, ueberlebt das
    Abmelden von RDP und liest fremde Benutzerprofile.
  - BootTrigger: nach einem Neustart (Windows-Update) laeuft der Server wieder.
  - ExecutionTimeLimit PT0S: unbegrenzt. Der Standard sind 72 Stunden - der
    Transfer dauert Tage und wuerde mittendrin beendet.
  - Akku/Leerlauf aus: sonst stoppt Windows die Aufgabe still.
  - Priority 4 = normale CPU- und E/A-Prioritaet. Der Standard 7 drosselt
    beides, und das Lesen der Quellplatte ist hier der Engpass.
  - RestartOnFailure greift nur, wenn die Aufgabe nicht STARTEN kann. Einen
    Absturz von rsync.exe mitten im Transfer faengt rsyncd-loop.cmd ab: es
    startet den Daemon nach 60 s neu, solange die Aufgabe laeuft.
  - Count 255: das Schema erlaubt hoechstens 255 (unsignedByte).
  - WorkingDirectory: lock/pid/log in rsyncd.conf stehen relativ.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>win2unix: temporaerer rsync-Server (read only). Entfernen mit STOP-RSYNC-SERVER.cmd.</Description>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>4</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>255</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%SystemRoot%\System32\cmd.exe</Command>
      <Arguments>/c rsyncd-loop.cmd</Arguments>
      <WorkingDirectory>@WORKDIR@</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
