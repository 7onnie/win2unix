def cmd_list():
    names = list_jobs()
    if not names:
        print("keine Auftraege")
        return
    print("  ".join(t.ljust(w) for t, w in COLS))
    for line in render_rows([job_state(n) for n in names], {}):
        print(line)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="w2u", description="win2unix-Transfers als Dienste")
    sub = ap.add_subparsers(dest="cmd")
    a = sub.add_parser("add", help="Auftrag anlegen")
    a.add_argument("name")
    a.add_argument("--ip", default="", help="Quell-IP (mit --pfad)")
    a.add_argument("--pfad", default="", help="Windows-Pfad, z.B. F:\\Ordner\\BRIEFE, oder rsync://-URL")
    a.add_argument("--ziel", required=True, help="Zielverzeichnis, darunter entsteht NAME")
    a.add_argument("--besitzer", required=True, help="BENUTZER:GRUPPE")
    a.add_argument("--jobs", type=int, default=0)
    a.add_argument("--neu-zuerst", type=int, default=DEFAULT_NEWDAYS, dest="newdays")
    a.add_argument("--start", action="store_true", help="gleich starten")
    sub.add_parser("list", help="Auftraege mit Status")
    for c in ("start", "stop", "restart", "remove", "log", "run"):
        sub.add_parser(c).add_argument("name")
    args = ap.parse_args(argv)
    try:
        if args.cmd is None:
            tui()
            return 0
        if args.cmd == "add":
            conf = add(args.name, source_url(args.ip, args.pfad), args.ziel, args.besitzer,
                       args.jobs, args.newdays)
            print(f"angelegt: {args.name}: {conf['SRC']} -> {target_of(conf)}")
            if args.start:
                cmd_start(args.name)
                print("gestartet")
        elif args.cmd == "list":
            cmd_list()
        elif args.cmd == "start":
            cmd_start(args.name)
        elif args.cmd == "stop":
            cmd_stop(args.name)
        elif args.cmd == "restart":
            cmd_restart(args.name)
        elif args.cmd == "remove":
            cmd_remove(args.name)
        elif args.cmd == "log":
            print(cmd_log(args.name))
        elif args.cmd == "run":
            return cmd_run(args.name)
    except ValueError as e:
        print(f"Fehler: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
